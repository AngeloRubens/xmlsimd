<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>org.simdxml</groupId><artifactId>simdxml-compatibility</artifactId>
        <version>0.1.0-SNAPSHOT</version><relativePath>../pom.xml</relativePath></parent>
    <artifactId>simdxml-iso20022-validation</artifactId>
    <name>simdxml ISO 20022 layered validation gate</name>
    <properties><maven.compiler.release>8</maven.compiler.release><junit.version>5.13.4</junit.version></properties>
    <dependencies>
        <dependency><groupId>org.simdxml</groupId><artifactId>simdxml-core-java8</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
    </dependencies>
    <build><testResources><testResource><directory>${project.basedir}/../../src/test/resources</directory>
        <includes><include>payments/*.xml</include></includes></testResource></testResources><plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version>
            <configuration><release>8</release></configuration></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.4</version>
            <configuration><argLine>-XX:ActiveProcessorCount=2</argLine><forkCount>1</forkCount><reuseForks>true</reuseForks>
                <parallel>none</parallel><useModulePath>false</useModulePath></configuration></plugin>
    </plugins></build>
</project>
