<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.simdxml</groupId><artifactId>simdxml-compatibility</artifactId>
        <version>0.1.0-SNAPSHOT</version><relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>simdxml-w3c-xml-kit</artifactId>
    <name>simdxml unofficial W3C XML test-suite runner</name>
    <properties>
        <maven.compiler.release>8</maven.compiler.release>
        <junit.version>5.13.4</junit.version>
        <xmlts.version>20130923</xmlts.version>
        <xmlts.url>https://www.w3.org/XML/Test/xmlts${xmlts.version}.tar.gz</xmlts.url>
        <xmlts.sha256>9b61db9f5dbffa545f4b8d78422167083a8568c59bd1129f94138f936cf6fc1f</xmlts.sha256>
        <xmlts.directory>${project.build.directory}/w3c-xmlts-${xmlts.version}</xmlts.directory>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.simdxml</groupId><artifactId>simdxml-core-java8</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version><scope>test</scope>
        </dependency>
    </dependencies>
    <build><plugins>
        <plugin>
            <groupId>com.googlecode.maven-download-plugin</groupId>
            <artifactId>download-maven-plugin</artifactId><version>1.9.0</version>
            <executions><execution><id>fetch-pinned-w3c-xmlts</id><phase>generate-test-resources</phase>
                <goals><goal>wget</goal></goals><configuration>
                    <url>${xmlts.url}</url>
                    <outputDirectory>${xmlts.directory}</outputDirectory>
                    <outputFileName>xmlts${xmlts.version}.tar.gz</outputFileName>
                    <sha256>${xmlts.sha256}</sha256>
                    <unpack>true</unpack>
                    <overwrite>false</overwrite>
                </configuration>
            </execution></executions>
        </plugin>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
            <version>3.14.1</version><configuration><release>${maven.compiler.release}</release></configuration>
        </plugin>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
            <version>3.5.4</version><configuration>
                <argLine>-XX:ActiveProcessorCount=2</argLine>
                <forkCount>1</forkCount><reuseForks>true</reuseForks><parallel>none</parallel>
                <useModulePath>false</useModulePath>
                <systemPropertyVariables>
                    <org.simdxml.w3c.xmlts>${xmlts.directory}/xmlconf</org.simdxml.w3c.xmlts>
                </systemPropertyVariables>
            </configuration>
        </plugin>
    </plugins></build>
</project>
